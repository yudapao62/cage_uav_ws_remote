Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /CAGE_0 Grid1
        - /Mission Waypoints1
        - /Planned Path1
        - /Actual Path1
        - /Flight Debug1
        - /Mission Status1
      Splitter Ratio: 0.55
    Tree Height: 620
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.588679
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Update Interval: 0
      Value: true
    - Alpha: 0.35
      Cell Size: 10
      Class: rviz/Grid
      Color: 110; 135; 145
      Enabled: false
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: ENU Debug Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 200
      Reference Frame: map
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /cage/grid/markers
      Name: CAGE_0 Grid
      Namespaces:
        cage_grid: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /cage/beacon/markers
      Name: Beacon Anchors
      Namespaces:
        beacon: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /feeding/target_cell_markers
      Name: Feeding Target Cells
      Namespaces:
        cage_grid: true
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /mission/visualization/markers
      Name: Mission Waypoints
      Namespaces:
        mission_waypoints: true
      Queue Size: 10
      Value: true
    - Alpha: 0.75
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 232; 120
      Enabled: true
      Head Diameter: 0.30
      Head Length: 0.20
      Length: 0.30
      Line Style: Lines
      Line Width: 0.10
      Name: Planned Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.10
      Shaft Length: 0.10
      Topic: /visualization/planned_path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 235; 55; 45
      Enabled: true
      Head Diameter: 0.30
      Head Length: 0.20
      Length: 0.30
      Line Style: Lines
      Line Width: 0.12
      Name: Actual Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.10
      Shaft Length: 0.10
      Topic: /visualization/actual_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /visualization/flight_markers
      Name: Flight Debug
      Namespaces:
        flight_debug: true
      Queue Size: 10
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /visualization/mission_status
      Name: Mission Status
      Namespaces:
        mission_status: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 42; 56; 64
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 190
      Focal Point:
        X: 80
        Y: 25
        Z: 10
      Name: Current View
      Pitch: 0.62
      Yaw: 0.88
      Target Frame: map
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1600
  X: 120
  Y: 80
