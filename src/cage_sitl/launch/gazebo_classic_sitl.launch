<launch>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find cage_simulation)/worlds/cage_mission.world"/>
  <param name="/simulation/backend" value="sitl"/>
  <param name="/use_sim_time" value="true"/>
  <env name="GAZEBO_MODEL_DATABASE_URI" value=""/>
  <env name="GAZEBO_MODEL_PATH"
       value="$(find cage_simulation)/models:$(env HOME)/ardupilot_gazebo/models:/usr/share/gazebo-11/models"/>
  <env name="GAZEBO_PLUGIN_PATH"
       value="$(env HOME)/ardupilot_gazebo/build:/usr/lib/x86_64-linux-gnu/gazebo-11/plugins:/opt/ros/noetic/lib"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
  </include>
</launch>
