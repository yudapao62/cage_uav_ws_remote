<?xml version="1.0"?>
<!-- World axis convention: matches the ArduPilot Gazebo plugin
     (gazeboXYZToNED = roll pi): world x = North, world y = -East, z = up.
     Cage endpoints from cage.yaml are generated in world coordinates at launch. -->
<sdf version="1.6">
  <world name="default">
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.48 0.54 0.53 1</ambient>
      <background>0.44 0.53 0.54 1</background>
      <shadows>true</shadows>
      <sky>
        <time>12</time><sunrise>6</sunrise><sunset>19</sunset>
        <clouds>
          <speed>0.15</speed><direction>0.4</direction><humidity>0.20</humidity>
          <mean_size>0.45</mean_size><ambient>0.85 0.88 0.92 1</ambient>
        </clouds>
      </sky>
    </scene>
    <gui fullscreen="false">
      <camera name="mission_overview"><pose>38 -116 112 0.58 0.0 -1.57</pose></camera>
    </gui>

    <include><uri>model://sun</uri></include>

    <include><uri>model://water_surface</uri></include>

    <include><name>iris_demo</name><uri>model://iris_with_ardupilot</uri></include>

    <!-- Multi-cage scene. CAGE_0 is the only targetable cage in phase one. -->
    <include><name>CAGE_0</name><uri>model://unit_cage</uri><pose>0 0 0 0 0 0</pose></include>
    <include><name>CAGE_1</name><uri>model://unit_cage</uri><pose>-95 -150 0 0 0 0.22</pose></include>
    <include><name>CAGE_2</name><uri>model://unit_cage</uri><pose>130 140 0 0 0 -0.18</pose></include>
    <include><name>CAGE_3</name><uri>model://unit_cage</uri><pose>250 0 0 0 0 0.12</pose></include>
    <include><name>CAGE_4</name><uri>model://unit_cage</uri><pose>40 -265 0 0 0 -0.10</pose></include>
  </world>
</sdf>
